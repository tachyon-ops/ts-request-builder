{
  "name": "ts-request-builder",
  "version": "0.2.1",
  "description": "Make your requests and life easier",
  "author": "Nuno Ribeiro <me@nuuno.art>",
  "keywords": [
    "typescript",
    "request",
    "api",
    "builder",
    "http",
    "utility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tachyon-ops/ts-request-builder.git"
  },
  "bugs": {
    "url": "https://github.com/tachyon-ops/ts-request-builder/issues"
  },
  "homepage": "https://github.com/tachyon-ops/ts-request-builder#readme",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "private": false,
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsup src/index.ts --dts --format esm,cjs --out-dir lib",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/ui": "^3.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.4.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
